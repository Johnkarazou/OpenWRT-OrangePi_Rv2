# Orange Pi RV2 — default build.
# Public "build my ROM" config: stock-like router with the full common-package
# set from openwrt_25.12_common_packages.txt (2026). USB/storage kernel support
# is built into the ky target; no disk packages needed.
CONFIG_TARGET_ky=y
CONFIG_TARGET_ky_riscv64=y
CONFIG_TARGET_ky_riscv64_DEVICE_x1_orangepi-rv2=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=128
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_VERSIONOPT=y
CONFIG_VERSION_REPO="https://raw.githubusercontent.com/Johnkarazou/OpenWRT-OrangePi_Rv2/packages"

# First-boot rootfs resize to full card size (also target default)
CONFIG_PACKAGE_ky-resize-rootfs=y

# Web UI — the stock experience
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-advanced-reboot=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y

# WAN
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y

# Firewall flow offloading (gigabit+ forwarding)
CONFIG_PACKAGE_kmod-nft-offload=y

# Wireless (board has no radio; covers USB/SDIO adapters too)
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_hostapd-utils=y

# VPN & tunnels
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-app-wireguard=y

# Dynamic DNS
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_luci-app-ddns=y

# QoS & performance
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_irqbalance=y

# DNS ad-blocking (modern variant)
CONFIG_PACKAGE_adblock-fast=y
CONFIG_PACKAGE_luci-app-adblock-fast=y

# DNS privacy
CONFIG_PACKAGE_https-dns-proxy=y
CONFIG_PACKAGE_luci-app-https-dns-proxy=y

# Hardware: thermal monitoring
CONFIG_PACKAGE_lm-sensors=y

# Community tools (forum.openwrt.org/t/122454)
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd-mod-cpu=y
CONFIG_PACKAGE_collectd-mod-interface=y
CONFIG_PACKAGE_collectd-mod-load=y
CONFIG_PACKAGE_collectd-mod-memory=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tcpdump-mini=y

# System
CONFIG_PACKAGE_zram-swap=y
CONFIG_VERSION_NUMBER="v1.0.0"
CONFIG_VERSIONOPT=y
CONFIG_VERSION_NUMBER="v1.0.0"
CONFIG_VERSION_REPO="https://raw.githubusercontent.com/Johnkarazou/OpenWRT-OrangePi_Rv2/packages/%v"
CONFIG_IMAGEOPT=y
