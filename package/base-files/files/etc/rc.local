# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# RPS on all interface RX queues (helps the single-queue PPPoE bottleneck)
for q in /sys/class/net/*/queues/rx-*; do
	echo ff > "$q/rps_cpus" 2>/dev/null
	echo 4096 > "$q/rps_flow_cnt" 2>/dev/null
done

# Lock CPU governor to performance
echo performance | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1

exit 0
